// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum OrderStatus {
  PENDING
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

model User {
  id        String    @id @default(cuid())
  phone     String    @unique
  name      String?   // فقط نام و نام‌خانوادگی در یک فیلد یا جداگانه
  role      Role      @default(USER)
  
  addresses Address[] // اضافه شدن ارتباط با جدول آدرس‌ها
  orders    Order[]
  
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Address {
  id          String   @id @default(cuid())
  title       String   // عنوان آدرس (مثلاً: خانه، محل کار)
  fullAddress String   // آدرس کامل پستی
  postalCode  String?  // کد پستی (برای ارسال پستی در ایران بسیار مهم است)
  
  // ارتباط با کاربر
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model OTP {
  id        String   @id @default(cuid())
  phone     String
  code      String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([phone])
}

model Category {
  id        String     @id @default(cuid())
  name      String
  slug      String     @unique
  imageUrl  String?
  parentId  String?
  parent    Category?  @relation("Subcategories", fields: [parentId], references: [id])
  children  Category[] @relation("Subcategories")
  products  Product[]
}

model Product {
  id            String      @id @default(cuid())
  title         String
  slug          String      @unique
  subtitle      String?     // اضافه شد: برای متن کوتاه زیر عنوان در کارت‌ها
  description   String   @db.Text      // برای توضیحات کامل در صفحه داخلی محصول
  price         Int
  discountedPrice Int? // قیمت نهایی (اگر تخفیف دارد)
  stock         Int
  images        String[]
  isAvailable   Boolean     @default(true)
  isFeatured      Boolean  @default(false) // <--- اضافه شد: برای بخش محصولات منتخب لندینگ
  categoryId    String
  category      Category    @relation(fields: [categoryId], references: [id])
  tags            Tag[]
  orderItems    OrderItem[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  videoUrl        String?   // لینک ویدیوی محصول
  richDescription String?   @db.Text // توضیحات کامل HTML برای ادیتور متن

  // ارتباطات (Relations) جدید:
  attributes      ProductAttribute[]
  reviews         Review[]
  faqs            ProductFAQ[]
}

// جدول ویژگی‌ها و مشخصات فنی (مثل حجم، نوع پوست و...)
model ProductAttribute {
  id        String  @id @default(cuid())
  key       String  // عنوان ویژگی (مثلاً "حجم")
  value     String  // مقدار ویژگی (مثلاً "۳۰ میلی‌لیتر")
  
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

// جدول نظرات کاربران
model Review {
  id          String   @id @default(cuid())
  userName    String   // نام کاربر
  text        String   @db.Text // متن نظر
  adminReply  String?  @db.Text // پاسخ ادمین
  isApproved  Boolean  @default(false) // وضعیت تایید (پیش‌فرض: در انتظار تایید)
  createdAt   DateTime @default(now())

  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

// جدول سوالات متداول اختصاصی هر محصول
model ProductFAQ {
  id        String   @id @default(cuid())
  question  String   // سوال
  answer    String   @db.Text // جواب
  createdAt DateTime @default(now())

  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}
model Tag {
  id        String    @id @default(uuid())
  name      String    @unique
  products  Product[] // ارتباط با محصولات
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}
model Order {
  id          String      @id @default(cuid())
  userId      String
  user        User        @relation(fields: [userId], references: [id])
  totalAmount Int
  status      OrderStatus @default(PENDING)
  items       OrderItem[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id])
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  price     Int
}