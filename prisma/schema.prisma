// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum OrderStatus {
  PENDING
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

model User {
  id        String    @id @default(cuid())
  phone     String    @unique
  name      String?   // فقط نام و نام‌خانوادگی در یک فیلد یا جداگانه
  role      Role      @default(USER)
  
  addresses Address[] // اضافه شدن ارتباط با جدول آدرس‌ها
  orders    Order[]
  
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Address {
  id          String   @id @default(cuid())
  title       String   // عنوان آدرس (مثلاً: خانه، محل کار)
  fullAddress String   // آدرس کامل پستی
  postalCode  String?  // کد پستی (برای ارسال پستی در ایران بسیار مهم است)
  
  // ارتباط با کاربر
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model OTP {
  id        String   @id @default(cuid())
  phone     String
  code      String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([phone])
}

model Category {
  id        String     @id @default(cuid())
  name      String
  slug      String     @unique
  parentId  String?
  parent    Category?  @relation("Subcategories", fields: [parentId], references: [id])
  children  Category[] @relation("Subcategories")
  products  Product[]
}

model Product {
  id            String      @id @default(cuid())
  title         String
  slug          String      @unique
  subtitle      String?     // اضافه شد: برای متن کوتاه زیر عنوان در کارت‌ها
  description   String      // برای توضیحات کامل در صفحه داخلی محصول
  price         Int
  stock         Int
  images        String[]
  badge         String?     // اضافه شد: برای تگ‌های زرد رنگ مثل "جدید" یا "پرفروش"
  isAvailable   Boolean     @default(true)
  categoryId    String
  category      Category    @relation(fields: [categoryId], references: [id])
  orderItems    OrderItem[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model Order {
  id          String      @id @default(cuid())
  userId      String
  user        User        @relation(fields: [userId], references: [id])
  totalAmount Int
  status      OrderStatus @default(PENDING)
  items       OrderItem[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id])
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  price     Int
}