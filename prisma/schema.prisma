// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum OrderStatus {
  PENDING
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

// ==========================================
// User & Authentication Models
// ==========================================

model User {
  id            String    @id @default(cuid())
  phone         String?   @unique // شماره موبایل (برای ورود با OTP)
  name          String?   // نام و نام‌خانوادگی
  email         String?   @unique // ایمیل (برای NextAuth و لاگین احتمالی با گوگل)
  emailVerified DateTime?
  image         String?   // عکس پروفایل
  role          Role      @default(USER)
  
  addresses     Address[]
  orders        Order[]
  accounts      Account[] // ارتباط با اکانت‌های NextAuth
  sessions      Session[] // ارتباط با سشن‌های NextAuth
  savedProducts Product[] @relation("UserWishlist")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

// جداول استاندارد NextAuth برای مدیریت سشن‌ها و شبکه‌های اجتماعی
model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?  @db.Text
  access_token       String?  @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?  @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model OTP {
  id        String   @id @default(cuid())
  phone     String
  code      String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([phone])
}

model Address {
  id          String   @id @default(cuid())
  title       String   // عنوان آدرس (مثلاً: خانه، محل کار)
  state       String   // استان (الزامی)
  city        String   // شهر (الزامی)
  fullAddress String   // آدرس کامل پستی
  postalCode  String   // کد پستی (الزامی شد)
  
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ==========================================
// E-Commerce Models
// ==========================================

model Category {
  id        String     @id @default(cuid())
  name      String
  slug      String     @unique
  imageUrl  String?
  parentId  String?
  parent    Category?  @relation("Subcategories", fields: [parentId], references: [id])
  children  Category[] @relation("Subcategories")
  products  Product[]
}

// مدل جدید برای برندها
model Brand {
  id          String    @id @default(cuid())
  name        String    // نام برند (مثل: تراست اسلیم)
  slug        String    @unique // برای استفاده در URL (مثل: trust-slim)
  logo        String?   // لوگوی برند (اختیاری)
  description String?   // توضیحات برند (اختیاری)
  
  products    Product[] // ارتباط با محصولات

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Product {
  id              String      @id @default(cuid())
  title           String
  slug            String      @unique
  savedByUsers    User[]      @relation("UserWishlist")
  subtitle        String?     
  description     String      @db.Text      
  richDescription String?     @db.Text 

  brandId     String?   // 👈 شناسه برند (اختیاری است چون ? دارد)
  brand       Brand?    @relation(fields: [brandId], references: [id])

  referenceUrl    String?
  
  price           Int
  discountedPrice Int? 
  stock           Int
  images          String[]
  videoUrls       String[]   
  isAvailable     Boolean     @default(true)
  isFeatured      Boolean     @default(false) 
  
  categoryId      String
  category        Category    @relation(fields: [categoryId], references: [id])
  tags            Tag[]
  
  orderItems      OrderItem[]
  attributes      ProductAttribute[]
  reviews         Review[]
  faqs            ProductFAQ[]
  
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

model ProductAttribute {
  id        String  @id @default(cuid())
  key       String  
  value     String  
  
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Review {
  id          String   @id @default(cuid())
  userName    String   
  text        String   @db.Text 
  adminReply  String?  @db.Text 
  isApproved  Boolean  @default(false) 
  
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  
  createdAt   DateTime @default(now())
}

model ProductFAQ {
  id        String   @id @default(cuid())
  question  String   
  answer    String   @db.Text 
  
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

model Tag {
  id        String    @id @default(uuid())
  name      String    @unique
  products  Product[] 
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

// ==========================================
// Order & Payment Models (Updated)
// ==========================================

model Order {
  id              String      @id @default(cuid())
  userId          String
  user            User        @relation(fields: [userId], references: [id])
  
  totalAmount     Int         // مبلغ کل پرداختی
  shippingCost    Int         @default(0)
  status          OrderStatus @default(PENDING)
  
  // اطلاعات درگاه پرداخت (زرین‌پال)
  authority       String?     @unique // کد یکتای زرین‌پال قبل از پرداخت
  refId           String?     // شماره پیگیری بعد از پرداخت موفق
  
  // اطلاعات خریدار و ارسال (ثبت ثابت در زمان خرید)
  customerName    String?
  customerPhone   String?
  shippingState   String?
  shippingCity    String?
  shippingAddress String?     @db.Text
  postalCode      String?
  
  items           OrderItem[]
  
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

model OrderItem {
  id        String  @id @default(cuid())
  
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  
  productId String
  product   Product @relation(fields: [productId], references: [id])
  
  quantity  Int
  price     Int     // قیمت محصول دقیقاً در لحظه خرید
}

// ==========================================
// Settings Model (برای تنظیماتی مثل هزینه پست)
// ==========================================
// ==========================================
// Settings Model (برای تنظیماتی مثل هزینه پست)
// ==========================================
model StoreSettings {
  id               String    @id @default("global")
  shippingCost     Int       @default(50000)

  // 👇 این خط مهم در فایل شما جا افتاده بود
  campaignIsActive Boolean   @default(false) 

  campaignTitle    String?   
  campaignEndDate  DateTime? 
  campaignLink     String?   
  
  updatedAt        DateTime  @updatedAt
}